---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import SectionHead from "../../components/SectionHead.astro";
import { href } from "../../lib/url";

const projects = (await getCollection("projects")).sort(
  (a, b) =>
    a.data.order - b.data.order ||
    +new Date(b.data.startDate ?? 0) - +new Date(a.data.startDate ?? 0),
);
const withBody = await Promise.all(
  projects.map(async (p) => ({ p, Content: (await render(p)).Content })),
);
const groups = [
  {
    id: "funded",
    title: "Funded research",
    items: withBody.filter((x) => x.p.data.kind === "funded"),
  },
  {
    id: "undergraduate",
    title: "Undergraduate research projects",
    items: withBody.filter((x) => x.p.data.kind === "undergraduate"),
  },
];

const fmt = (d?: string) =>
  d
    ? new Date(d).toLocaleDateString("en-GB", { month: "short", year: "numeric", timeZone: "UTC" })
    : "";
---

<Base title="Projects" description="Funded and student-led research projects at the JUST Lab.">
  <section class="wrap head">
    <SectionHead
      kicker="Projects"
      title="Research projects"
      lead="Grant-funded and student-led projects of the JUST Lab."
    />
  </section>

  {
    groups.map(
      (g) =>
        g.items.length > 0 && (
          <section class="wrap grp">
            <h2 class="grp-h">{g.title}</h2>
            <div class="rows">
              {g.items.map(({ p, Content }) => (
                <div class="row">
                  <a class="proj" href={href(`/projects/${p.id}`)}>
                    {p.data.shortName && (
                      <span class="mono tag">{p.data.shortName}</span>
                    )}
                    <h3>{p.data.title}</h3>
                    <p class="meta">
                      {p.data.funder
                        ? `${p.data.funder}${p.data.process ? ` · ${p.data.process}` : ""} · `
                        : ""}
                      {fmt(p.data.startDate)}
                      {p.data.endDate ? ` – ${fmt(p.data.endDate)}` : " – present"}
                    </p>
                    <p class="pi">
                      {p.data.researcher
                        ? `${p.data.researcher} · Supervisor: ${p.data.pi}`
                        : `PI: ${p.data.pi}`}
                    </p>
                  </a>
                  <div class="desc">
                    <span class="mono tag">About the project</span>
                    <div class="prose">
                      <Content />
                    </div>
                    <a class="more" href={href(`/projects/${p.id}`)}>
                      Project details →
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </section>
        ),
    )
  }
</Base>

<style>
  .head {
    padding-bottom: 1.5rem;
  }
  .grp {
    padding-block: 1.5rem clamp(1.5rem, 4vw, 2.5rem);
  }
  .grp-h {
    font-size: 1.25rem;
    margin-bottom: 1.2rem;
  }
  .rows {
    display: grid;
    gap: 1.2rem;
  }
  .row {
    display: grid;
    grid-template-columns: minmax(260px, 340px) 1fr;
    gap: 1.2rem;
    align-items: stretch;
  }
  .proj,
  .desc {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .proj {
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.2s var(--ease),
      border-color 0.2s;
  }
  .proj:hover,
  .proj:focus-visible {
    transform: translateY(-3px);
    border-color: var(--accent);
  }
  .tag {
    color: var(--accent);
    font-size: 0.66rem;
  }
  .proj h3 {
    font-size: 1.05rem;
  }
  .meta {
    color: var(--ink-soft);
    font-size: 0.85rem;
    margin: 0;
  }
  .pi {
    color: var(--ink-faint);
    font-size: 0.85rem;
    margin: 0;
  }
  .desc :global(p) {
    color: var(--ink-soft);
    font-size: 0.93rem;
    line-height: 1.65;
    margin: 0;
  }
  .desc .prose {
    max-width: none;
  }
  .more {
    margin-top: auto;
    padding-top: 0.6rem;
    font-size: 0.9rem;
  }
  @media (max-width: 800px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
