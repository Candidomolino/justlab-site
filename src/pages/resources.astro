---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import SectionHead from "../components/SectionHead.astro";
import HardwareCard from "../components/HardwareCard.astro";
import { href } from "../lib/url";

const hardware = (await getCollection("hardware")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base
  title="Resources"
  description="Protocols, open hardware, datasets, and code from the JUST Lab."
>
  <section class="wrap">
    <SectionHead
      kicker="Resources"
      title="Open protocols, hardware, data, and code"
      lead="The JUST Lab shares its methods and tools openly. This page is being populated — the sections below show what will live here."
    />
  </section>

  <section class="wrap">
    <h2 class="hw-h">Open hardware</h2>
    <p class="hw-lead">
      Seven projects — photobioreactors, light control, sensors and a 3D-printed
      centrifuge — designed and documented openly, each stating what it has not yet
      measured.
      <a href={href("/resources/hardware/")}>See all open hardware →</a>
    </p>
    <div class="hw-grid">
      {hardware.map((item) => <HardwareCard item={item} />)}
    </div>
  </section>

  <section class="wrap">
    <div class="grid">
      <div class="card">
        <h3>Protocols</h3>
        <p>
          Step-by-step methods for transformation, screening, cultivation, and
          downstream processing — each linked to a document or protocols.io entry.
        </p>
        <p class="mono todo">TODO: add protocol links</p>
      </div>
      <div class="card">
        <h3>Datasets</h3>
        <p>Published datasets with repository links (Zenodo, OSF).</p>
        <p class="mono todo">TODO: add dataset DOIs</p>
      </div>
      <div class="card">
        <h3>Software &amp; code</h3>
        <p>Analysis scripts, vector-design tools, and other code.</p>
        <p class="mono todo">TODO: add repository links</p>
      </div>
      <div class="card">
        <h3>Strains &amp; plasmids</h3>
        <p>Availability of strains and plasmids; Addgene links where deposited.</p>
        <p class="mono todo">TODO</p>
      </div>
      <div class="card">
        <h3>Teaching materials</h3>
        <p>Course and workshop content.</p>
        <p class="mono todo">TODO</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .hw-h {
    font-size: 1.4rem;
  }
  .hw-lead {
    color: var(--ink-soft);
    max-width: 62ch;
    margin-top: 0.6rem;
  }
  .hw-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.2rem;
    margin-top: 1.6rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.2rem;
  }
  .card h3 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }
  .card p {
    color: var(--ink-soft);
    font-size: 0.92rem;
  }
  .todo {
    color: var(--gold);
    font-size: 0.66rem;
  }
</style>
