---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../../layouts/Base.astro";
import { href } from "../../../lib/url";
import { hwImage, stageLabel } from "../../../lib/hardware";

export async function getStaticPaths() {
  const items = await getCollection("hardware");
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const d = item.data;
const { Content } = await render(item);
const hero = hwImage(d.hero);
const gallery = d.images
  .map((i) => ({ ...i, src: hwImage(i.file) }))
  .filter((i) => i.src);
---

<Base title={`${d.name} — open hardware`} description={d.summary}>
  <article class="wrap hw">
    <p><a href={href("/resources/hardware/")}>← All open hardware</a></p>
    <span class={`stage mono s-${d.stage}`}>{stageLabel[d.stage]}</span>
    <h1>{d.name}</h1>
    <p class="subtitle">{d.title}</p>

    {
      hero && (
        <figure class="hero">
          <Image src={hero} alt="" width={1200} loading="eager" />
        </figure>
      )
    }

    <dl class="facts">
      {d.scale && <div><dt>Scale</dt><dd>{d.scale}</dd></div>}
      {d.cost && <div><dt>Cost</dt><dd>{d.cost}</dd></div>}
      {d.authors && <div><dt>Author</dt><dd>{d.authors}</dd></div>}
      {d.license && <div><dt>Licence</dt><dd>{d.license}</dd></div>}
    </dl>

    <div class="prose body"><Content /></div>

    {
      d.specs.length > 0 && (
        <section>
          <h2>Specifications</h2>
          <table class="specs">
            <tbody>
              {d.specs.map((s) => (
                <tr>
                  <th scope="row">{s.label}</th>
                  <td>{s.value}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="mono hint">
            “Rated”, “nominal” and “target” values are ratings or goals, not
            measurements.
          </p>
        </section>
      )
    }

    {
      gallery.length > 0 && (
        <section>
          <h2>Images</h2>
          <div class="gallery">
            {gallery.map((g) => (
              <figure>
                <Image src={g.src!} alt={g.alt} width={900} />
                <figcaption>
                  {g.caption}
                  <span class="credit mono">
                    {g.credit === "photo" ? "Photo: João Vitor Dutra Molino" : "Figure: CC-BY-4.0"}
                  </span>
                </figcaption>
              </figure>
            ))}
          </div>
        </section>
      )
    }

    {
      d.files && (
        <section>
          <h2>Design files</h2>
          <p class="body">{d.files}</p>
        </section>
      )
    }
  </article>
</Base>

<style>
  .hw {
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }
  .stage {
    display: inline-block;
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: 99px;
    padding: 0.25rem 0.7rem;
    margin-top: 0.8rem;
  }
  .s-preliminary,
  .s-future {
    color: var(--gold);
    background: transparent;
    border: 1px dashed var(--gold);
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    margin-top: 0.5rem;
  }
  .subtitle {
    color: var(--ink-soft);
    font-size: 1.1rem;
    margin-top: 0.3rem;
  }
  .hero {
    margin: 2rem 0 0;
  }
  .hero :global(img) {
    width: 100%;
    max-height: 520px;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    display: block;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1rem 2rem;
    margin: 2rem 0;
    padding: 1.5rem 0;
    border-block: 1px solid var(--line);
  }
  .facts dt {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .facts dd {
    margin: 0.2rem 0 0;
    font-size: 0.95rem;
  }
  .body {
    color: var(--ink-soft);
  }
  .body :global(h2),
  section h2 {
    font-size: 1.35rem;
    margin: 2.4rem 0 0.8rem;
    color: var(--ink);
  }
  .specs {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }
  .specs th,
  .specs td {
    text-align: left;
    vertical-align: top;
    padding: 0.7rem 0.9rem 0.7rem 0;
    border-bottom: 1px solid var(--line);
  }
  .specs th {
    width: 11rem;
    font-weight: 600;
    color: var(--ink);
  }
  .specs td {
    color: var(--ink-soft);
  }
  .hint {
    color: var(--ink-faint);
    font-size: 0.68rem;
    margin-top: 0.8rem;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.4rem;
  }
  .gallery figure {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .gallery :global(img) {
    width: 100%;
    height: auto;
    display: block;
    background: #fff;
  }
  figcaption {
    padding: 0.9rem 1.1rem 1.1rem;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }
  .credit {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.62rem;
    color: var(--ink-faint);
  }
</style>
